# ──────────────────────────────────────────────────────────────────────────────
# ZipLink — variáveis de ambiente
# Copie para .env e preencha os valores antes de rodar docker compose up
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# URL pública base (usada para gerar short links nos resultados do batch)
BASE_URL=http://localhost

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=ziplink
POSTGRES_PASSWORD=ziplink_secret
POSTGRES_DB=ziplink_db

# ── Auth ──────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Troque antes de qualquer deploy.
JWT_SECRET=change_me_to_a_random_32_char_string!!
BCRYPT_ROUNDS=10

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
