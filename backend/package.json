{
  "name": "ziplink-backend",
  "version": "1.0.0",
  "description": "ZipLink - High Performance URL Shortener API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/workers/index.ts",
    "worker:prod": "node dist/workers/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "db:migrate": "tsx src/config/migrate.ts"
  },
  "dependencies": {
    "@bull-board/api": "^5.21.0",
    "@bull-board/fastify": "^5.21.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "csv-parse": "^5.5.6",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "nanoid": "^3.3.7",
    "pg": "^8.12.0",
    "pino": "^9.3.1",
    "pino-pretty": "^11.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
